// Cloudflare Workers config for the Bluvu marketing site (static files only).
// Deploy from this folder:  npx wrangler@4 deploy
{
  "name": "bluvu-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Custom domain: added once bluvu.video is on this Cloudflare account.
  // "routes": [
  //   { "pattern": "bluvu.video", "custom_domain": true },
  //   { "pattern": "www.bluvu.video", "custom_domain": true }
  // ]
}
